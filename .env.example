# .env.example — copy to .env and fill in.
# Only MODEL_CHECKPOINT is required; everything else degrades gracefully.

# --- Graph store (default: kuzu; tigergraph needs cloud credits) ---
GRAPH_BACKEND=kuzu
# Local Kuzu directory (resets on Railway redeploy unless a volume is mounted)
KUZU_DB_PATH=./data/terrain_kuzu

# --- TigerGraph (only for GRAPH_BACKEND=tigergraph) ---
# Without credits, the pipeline still segments, plans paths (Python Dijkstra),
# and briefs — it just skips graph uploads and similarity memory.
TIGERGRAPH_HOST=
TIGERGRAPH_API_TOKEN=
TIGERGRAPH_GRAPH_NAME=AutonomousGraph

# --- LLM briefing keys (optional; tried in this order, then template) ---
# Groq: free → console.groq.com | Gemini: free → aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Segmentation backend ---
# "local": torch in-process (needs ~1GB+ RAM). Default for local dev.
# "space": call the HuggingFace Space /segment endpoint (lean, fits 512MB).
# Railway free tier MUST use "space".
INFERENCE_BACKEND=local

# "user/space-name" of the deployed inference Space (only for space mode).
HF_SPACE_ID=

# --- Model weights (local mode only) ---
# Local checkpoint, or run `python download_model.py` to fetch from HF Hub
# (it writes this line for you, pointing at runs/deployed/best.pth).
MODEL_CHECKPOINT=./runs/deployed/best.pth

# --- HuggingFace model repo (for download_model.py) ---
HF_MODEL_REPO=mk1647/terrain-intelligence
HF_TOKEN=
